# Authentication configuration
# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Admin account details used for sign-in
ADMIN_EMAIL=
# Optionally provide a display name for the admin dashboard welcome message
ADMIN_NAME=Community Admin

# Provide either ADMIN_PASSWORD_HASH (recommended) or ADMIN_PASSWORD (plaintext)
# To generate a SHA-256 hash run:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
